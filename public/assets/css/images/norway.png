    <div class="services bul_blue">
        <div class="services_top">
            <h4 style="text-align: center; color:#212121; font-size:46px;font-weight:200px;">Our<span
                    style="color: transparent; -webkit-text-stroke: 1px var(--dsvy-rodiar-blackish-color);">
                    Product</span></h4>
            <p class="text-center">Choose from the wide range of high quality gear pumps <br> for multiple industrial
                applications. </p>
        </div>
        <div class="services_data">
            <div class="serv aos-init aos-animate">
